# Copy to .env and replace every placeholder. Never commit .env.

ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://resume_app:CHANGE_ME_DB_PASSWORD@localhost:5432/resume_analyzer

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=720
COOKIE_SECURE=false

# Origins allowed to call the API directly (comma separated) and the public frontend URL.
FRONTEND_ORIGINS=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000

UPLOAD_DIR=storage/uploads
MAX_UPLOAD_MB=5
MAX_PDF_PAGES=10

# AI provider: "mock" (rule-based demo, no external calls) or "openai" (any OpenAI-compatible API).
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-5-mini
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=1
AI_RATE_LIMIT_PER_MINUTE=5
AI_RATE_LIMIT_PER_DAY=100

LOGIN_RATE_LIMIT_PER_MINUTE=10
UPLOAD_RATE_LIMIT_PER_HOUR=30

# Optional SMTP for password reset emails. Without it, development prints reset links to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
SMTP_STARTTLS=true
